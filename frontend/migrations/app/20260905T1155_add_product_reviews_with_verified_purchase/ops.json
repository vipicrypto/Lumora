    "execute": [
      {
        "description": "create table \"review\"",
        "sql": "CREATE TABLE \"public\".\"review\" (\n  \"comment\" text,\n  \"createdAt\" timestamptz NOT NULL,\n  \"id\" text NOT NULL,\n  \"productId\" text NOT NULL,\n  \"rating\" int4 NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" text NOT NULL,\n  \"verifiedPurchase\" bool DEFAULT false NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"review_rating_range_check_d64e03d9\" CHECK ((rating >= 1 AND rating <= 5))\n)",
        "params": []
      }
    ],

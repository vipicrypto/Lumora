model User {
  id            String         @id
  email         String         @unique
  name          String?
  role          UserRole       @default(CUSTOMER)
  passwordHash  String?

  orders        Order[]
  wishlistItems WishlistItem[]
  addresses     Address[]
  reviews       Review[]
}

enum UserRole {
  @@type("pg/text@1")

  CUSTOMER
  ADMIN
}

model Product {
  id            String  @id
  name          String
  description   String
  price         Decimal

  category      String
  categoryId    String?
  recipient     String?
  occasion      String?

  image         String
  isNew         Boolean
  isActive      Boolean
  stock         Int      @default(0)
  youtubeVideo  String?

  materials     String?
  shipping      String?
  returns       String?

  categoryRef   Category? @relation(fields: [categoryId], references: [id])

  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
}

model Review {
  id               String   @id
  productId        String
  userId           String

  rating           Int
  comment          String?
  verifiedPurchase Boolean  @default(false)

  createdAt        DateTime
  updatedAt        DateTime

  product          Product  @relation(fields: [productId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId], map: "review_productId_userId_key")
  @@check(
    expression: "(rating >= 1 AND rating <= 5)",
    name: "review_rating_range_check"
  )
}

model HeroSlide {
  id                String   @id
  title             String
  description       String?
  mediaType         String
  mediaUrl          String
  buttonText        String?
  buttonLink        String?
  sortOrder         Int
  isActive          Boolean
  animation         String   @default("fade")
  animationDuration Int      @default(600)
  createdAt         DateTime @default(now())
  updatedAt         DateTime
}

model HomeSection {
  id        String   @id
  key       String   @unique
  title     String
  subtitle  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
}

model Category {
  id          String    @id
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime

  products    Product[]
}

model Recipient {
  id          String   @id
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model Occasion {
  id          String   @id
  name        String   @unique
  slug         String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model Order {
  id            String      @id
  userId        String?

  customerName  String
  customerEmail String
  subtotal      Decimal
  shipping      Decimal
  total         Decimal
  paymentMethod String
  status        OrderStatus

  user          User?       @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id          String   @id
  orderId     String
  productId   String?

  productName String
  quantity    Int
  unitPrice   Decimal
  totalPrice  Decimal

  order       Order    @relation(fields: [orderId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])
}

model WishlistItem {
  id        String  @id
  userId    String
  productId String

  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Address {
  id           String  @id
  userId       String

  firstName    String
  lastName     String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String
  country      String
  phone        String?
  isDefault    Boolean

  user         User    @relation(fields: [userId], references: [id])
}

enum OrderStatus {
  @@type("pg/text@1")

  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}